---
/**
 * Közös fejléc: szöveges logó, menü, ajánlatkérés gomb.
 * Az aktuális oldal menüpontja kapja az "is-active" osztályt.
 */
const links = [
	{ href: "/", label: "Főoldal" },
	{ href: "/szolgaltatasok", label: "Szolgáltatások" },
	{ href: "/referenciak", label: "Referenciák" },
	{ href: "/kapcsolat", label: "Kapcsolat" },
] as const;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
	if (href === "/") {
		return path === "/";
	}

	return path === href;
}
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-logo" href="/">Webfejlesztő</a>

		<button
			class="menu-toggle"
			type="button"
			aria-controls="site-nav"
			aria-expanded="false"
			data-menu-toggle
		>
			Menü
		</button>

		<nav id="site-nav" class="site-nav" data-site-nav aria-label="Főmenü">
			<ul class="site-nav__list">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={["site-nav__link", { "is-active": isCurrent(link.href) }]}
								aria-current={isCurrent(link.href) ? "page" : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="site-nav__cta" href="/kapcsolat">Ajánlatot kérek</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector("[data-menu-toggle]");
	const nav = document.querySelector("[data-site-nav]");

	if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
		toggle.addEventListener("click", () => {
			const open = toggle.getAttribute("aria-expanded") === "true";
			toggle.setAttribute("aria-expanded", String(!open));
			nav.classList.toggle("is-open", !open);
		});
	}
</script>
